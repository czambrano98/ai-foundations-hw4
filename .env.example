# Copy this file to .env and fill in your real key. Never commit the real .env.
#
# API key for the model gateway (Portkey) the shop agent calls. The backend
# looks for this in the environment, then backend/.env, then env.txt files.
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional: override the session-token signing secret. If unset, the backend
# generates one into backend/.session_secret on first run (gitignored).
# CAMPUS_CUSTOMS_SECRET=some_long_random_string
