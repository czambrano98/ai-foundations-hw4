# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Build output
dist/
dist-ssr/
*.local

# Extracted data.
# data.zip is committed as the source of truth; everything under data/ is
# reproducible from it via `unzip data.zip` + `python scripts/add_category.py`.
# Keeping the unpacked copy out avoids committing a binary DB that changes
# every time the category script runs.
data/

# Secrets — API keys for the Problem 5 agent land here
.env
.env.*
!.env.example

# Session signing secret, generated on first run (backend/auth.py)
.session_secret

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
